{
  "name": "FIMS R and Julia user",
  "image": "ghcr.io/rocker-org/devcontainer/r-ver:4.5",
  "features": {
    "ghcr.io/julialang/devcontainer-features/julia:1": {
      "version": "1.10"
    }
  },
  "postCreateCommand": "Rscript -e 'install.packages(\"pak\"); pak::pak(\"local::.\"); FIMS::setup_julia()'",
  "customizations": {
    "vscode": {
      "extensions": ["reditorsupport.r", "julialang.language-julia"]
    }
  }
}
